# Layer checkouts — large, reproducible via docker/README instructions, not tracked
/sources/*

# BitBake build directory — regenerated by oe-init-build-env; only the
# hand-edited conf templates under build/conf-templates/ are tracked
/build/*
!/build/conf-templates/
!/build/conf-templates/**

# Yocto download/shared-state caches if pointed inside the repo
/downloads/
/sstate-cache/
